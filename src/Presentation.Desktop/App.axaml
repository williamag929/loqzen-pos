<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Presentation.Desktop.App"
             xmlns:local="using:Presentation.Desktop"
             xmlns:conv="using:Presentation.Desktop.Converters"
             RequestedThemeVariant="Dark">
             <!-- Dark is the default look; ThemeService switches to Light (Styles/Theme.axaml has both token sets). -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Presentation.Desktop/Styles/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToColorConverter x:Key="BoolToColor"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Presentation.Desktop/Styles/Controls.axaml"/>
    </Application.Styles>
</Application>