<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Presentation.Desktop.ViewModels"
        xmlns:views="using:Presentation.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Presentation.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Loqzen POS Standalone - Volcora Edition"
        WindowState="Maximized"
        Background="#0F172A">

    <Grid RowDefinitions="Auto, *">
        <!-- GLOBAL APP HEADER & NAVIGATION BAR -->
        <Border Grid.Row="0" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Brand Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="LOQZEN" Foreground="White" FontWeight="Black" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Terminal POS Standalone" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock Text="OFFLINE-FIRST" Foreground="#10B981" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Navigation Tabs (Touch targets >= 48px) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Height="44" 
                            Padding="20,0" 
                            CornerRadius="8"
                            FontWeight="Bold"
                            FontSize="14"
                            Content="🛒 Punto de Venta"
                            Background="{Binding IsCheckoutActive, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:True}, FallbackValue='#3B82F6'}"
                            Foreground="White"
                            Command="{Binding ShowCheckoutCommand}"/>

                    <Button Height="44" 
                            Padding="20,0" 
                            CornerRadius="8"
                            FontWeight="Bold"
                            FontSize="14"
                            Content="👨‍🍳 Cocina KDS"
                            Background="#1E293B"
                            Foreground="White"
                            Command="{Binding ShowKdsAsyncCommand}"/>
                </StackPanel>

                <!-- Peripherals & Dual Screen Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Height="42" 
                            Padding="12,0" 
                            Background="#1E293B" 
                            BorderBrush="#38BDF8" 
                            BorderThickness="1" 
                            CornerRadius="8"
                            Foreground="#38BDF8"
                            FontWeight="Bold"
                            Content="⚡ Barcode Scan"
                            ToolTip.Tip="Simular lectura de escáner USB HID"
                            Command="{Binding TriggerBarcodeScanCommand}"/>

                    <Button Height="42" 
                            Padding="12,0" 
                            Background="#1E293B" 
                            BorderBrush="#10B981" 
                            BorderThickness="1" 
                            CornerRadius="8"
                            Foreground="#10B981"
                            FontWeight="Bold"
                            Content="🖥️ Visor Cliente"
                            ToolTip.Tip="Abrir ventana del visor del cliente (pantalla secundaria)"
                            Command="{Binding OpenCustomerDisplayCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN VIEW HOST -->
        <Grid Grid.Row="1">
            <views:CheckoutView DataContext="{Binding Checkout}" IsVisible="{Binding IsCheckoutActive}" />
            <views:KdsView DataContext="{Binding Kds}" IsVisible="{Binding IsKdsActive}" />
        </Grid>
    </Grid>

</Window>
