<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Presentation.Desktop.ViewModels"
        xmlns:views="using:Presentation.Desktop.Views"
        xmlns:converters="using:Presentation.Desktop.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Presentation.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Loqzen POS Standalone - Volcora Edition"
        WindowState="Maximized"
        Background="#0F172A">

    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- ── GLOBAL NAV BAR ─────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="LOQZEN" Foreground="White" FontWeight="Black" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Terminal POS Standalone" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock Text="OFFLINE-FIRST" Foreground="#10B981" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Navigation Tabs – touch targets >= 48px -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Height="44" Padding="18,0" CornerRadius="8" FontWeight="Bold" FontSize="14"
                            Content="🛒 Punto de Venta"
                            Background="{Binding IsCheckoutActive, Converter={StaticResource BoolToColor}, ConverterParameter='#2563EB|#1E293B'}"
                            Foreground="White" Command="{Binding ShowCheckoutCommand}"/>

                    <Button Height="44" Padding="18,0" CornerRadius="8" FontWeight="Bold" FontSize="14"
                            Content="🍽️ Mesas / Comandas"
                            Background="{Binding IsComandaActive, Converter={StaticResource BoolToColor}, ConverterParameter='#2563EB|#1E293B'}"
                            Foreground="White" Command="{Binding ShowComandasCommand}"/>

                    <Button Height="44" Padding="18,0" CornerRadius="8" FontWeight="Bold" FontSize="14"
                            Content="👨‍🍳 KDS Cocina"
                            Background="{Binding IsKdsActive, Converter={StaticResource BoolToColor}, ConverterParameter='#2563EB|#1E293B'}"
                            Foreground="White" Command="{Binding ShowKdsCommand}"/>

                    <Button Height="44" Padding="18,0" CornerRadius="8" FontWeight="Bold" FontSize="14"
                            Content="💼 Turno de Caja"
                            Background="{Binding IsCashShiftActive, Converter={StaticResource BoolToColor}, ConverterParameter='#2563EB|#1E293B'}"
                            Foreground="White" Command="{Binding ShowCashShiftCommand}"/>

                    <Button Height="44" Padding="18,0" CornerRadius="8" FontWeight="Bold" FontSize="14"
                            Content="🗂️ Maestros"
                            Background="{Binding IsMastersActive, Converter={StaticResource BoolToColor}, ConverterParameter='#2563EB|#1E293B'}"
                            Foreground="White" Command="{Binding ShowMastersCommand}"/>
                </StackPanel>

                <!-- Peripheral Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Height="42" Padding="12,0"
                            Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8"
                            Foreground="#38BDF8" FontWeight="Bold"
                            Content="⚡ Scan"
                            ToolTip.Tip="Simular escáner USB HID (Código de Barras)"
                            Command="{Binding TriggerBarcodeScanCommand}"/>

                    <Button Height="42" Padding="12,0"
                            Background="#1E293B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8"
                            Foreground="#10B981" FontWeight="Bold"
                            Content="🖥️ Visor Cliente"
                            ToolTip.Tip="Abrir pantalla secundaria del cliente"
                            Command="{Binding OpenCustomerDisplayCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── VIEW HOST ──────────────────────────────────────────── -->
        <!-- IsVisible must live on a WRAPPER: on the same element as DataContext="{Binding X}"
             it would resolve against the child ViewModel (no IsXActive there) → binding fails →
             every view stays visible and the last one covers the rest. -->
        <Grid Grid.Row="1">
            <Panel IsVisible="{Binding IsCheckoutActive}"><views:CheckoutView  DataContext="{Binding Checkout}"/></Panel>
            <Panel IsVisible="{Binding IsKdsActive}"><views:KdsView            DataContext="{Binding Kds}"/></Panel>
            <Panel IsVisible="{Binding IsCashShiftActive}"><views:CashShiftView DataContext="{Binding CashShift}"/></Panel>
            <Panel IsVisible="{Binding IsMastersActive}"><views:MastersView    DataContext="{Binding Masters}"/></Panel>
            <Panel IsVisible="{Binding IsComandaActive}"><views:ComandaView    DataContext="{Binding Comanda}"/></Panel>
        </Grid>

    </Grid>
</Window>
