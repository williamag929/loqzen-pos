<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Presentation.Desktop.ViewModels"
        xmlns:views="using:Presentation.Desktop.Views"
        xmlns:converters="using:Presentation.Desktop.Converters"
        xmlns:i18n="using:Presentation.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Presentation.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{i18n:Loc App.Title}"
        WindowState="Maximized"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource BgApp}">

    <Window.Resources>
        <!-- Legacy converter, still looked up by StaticResource in older child views (also registered in App.axaml). -->
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Rows inside the "⋯" flyout: the same chips at full size, left-aligned, wrapping long status texts. -->
        <Style Selector="StackPanel.flyout > Button.chip">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="NaN"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="StackPanel.flyout > Border.chipRow">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="StackPanel.flyout TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Terminal chip in the bar: a Border (not a button) that shares the chip geometry. -->
        <Style Selector="Border.chipRow">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <!-- Root Panel: app chrome + full-window overlays (manager PIN, login) that render on top. -->
    <Panel>
    <Grid RowDefinitions="Auto, *">

        <!-- ── GLOBAL NAV BAR ─────────────────────────────────────────
             Responsive (MainViewModel.SetWidth): < 1200 px IsCompact → short tab labels + Button.tab.compact;
             < 1750 px IsToolsCollapsed → the tool chips collapse into ONE "⋯" chip with a Flyout; ≥ 2100 px IsWide →
             brand subtitle. The tabs live in a WrapPanel: if a role/terminal combination still does not fit, they
             wrap to a second row instead of overlapping the tools. MinWidth 900. -->
        <Border Grid.Row="0" Background="{DynamicResource BgBar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="{DynamicResource Accent}" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="{i18n:Loc App.Brand}" Foreground="{DynamicResource TextOnAccent}" FontWeight="Black" FontSize="13"/>
                    </Border>
                    <TextBlock Text="{i18n:Loc App.Subtitle}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                               IsVisible="{Binding IsWide}"/>
                    <Border Background="{DynamicResource SuccessSurface}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" IsVisible="{Binding IsWide}">
                        <TextBlock Text="{i18n:Loc App.OfflineFirst}" Foreground="{DynamicResource SuccessText}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Navigation Tabs – Button.tab (48 px touch targets, hover fixed in Styles/Controls.axaml);
                     .active = current screen, .compact = narrow window. Each tab hides for roles that may not use it
                     AND on a satellite register (Maestros lives on the master). -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Classes="tab" Classes.active="{Binding IsCheckoutActive}" Classes.compact="{Binding IsCompact}"
                            Content="{Binding CheckoutTabLabel}" IsVisible="{Binding IsCheckoutTabVisible}"
                            Command="{Binding ShowCheckoutCommand}"/>

                    <Button Classes="tab" Classes.active="{Binding IsComandaActive}" Classes.compact="{Binding IsCompact}"
                            Content="{Binding ComandasTabLabel}" IsVisible="{Binding IsComandasTabVisible}"
                            Command="{Binding ShowComandasCommand}"/>

                    <Button Classes="tab" Classes.active="{Binding IsKdsActive}" Classes.compact="{Binding IsCompact}"
                            Content="{Binding KdsTabLabel}" IsVisible="{Binding IsKdsTabVisible}"
                            Command="{Binding ShowKdsCommand}"/>

                    <Button Classes="tab" Classes.active="{Binding IsCashShiftActive}" Classes.compact="{Binding IsCompact}"
                            Content="{Binding CashShiftTabLabel}" IsVisible="{Binding IsCashShiftTabVisible}"
                            Command="{Binding ShowCashShiftCommand}"/>

                    <Button Classes="tab" Classes.active="{Binding IsBillPaymentsActive}" Classes.compact="{Binding IsCompact}"
                            Content="{Binding BillPaymentsTabLabel}" IsVisible="{Binding IsBillPaymentsTabVisible}"
                            Command="{Binding ShowBillPaymentsCommand}"/>

                    <Button Classes="tab" Classes.active="{Binding IsMastersActive}" Classes.compact="{Binding IsCompact}"
                            Content="{Binding MastersTabLabel}" IsVisible="{Binding IsMastersTabVisible}"
                            Command="{Binding ShowMastersCommand}"/>
                </WrapPanel>

                <!-- Tools: every chip has a SHORT visible label (no tooltip-only chips: tooltips do not exist on touch)
                     and a distinct icon: ▣ scanner · 📺 customer display · 🌐 LAN · 🏪 this register · 👤 user · 🌙/☀️ theme · 🌐 language.
                     Colour semantics (BorderBrush/Foreground): Info scanner, Success display, Purple LAN, register =
                     TerminalChipColor (green ok / amber offline-pending / red error), Warning change-user. -->
                <Panel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">

                    <!-- Expanded (≥ 1750 px): chips side by side. -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding IsToolsExpanded}">
                        <Button Classes="chip" IsVisible="{Binding Session.CanAccessCheckout}"
                                BorderBrush="{DynamicResource Info}" Foreground="{DynamicResource Info}"
                                Content="{Binding ScanLabel}" ToolTip.Tip="{Binding ScanFullLabel}"
                                Command="{Binding TriggerBarcodeScanCommand}"/>

                        <Button Classes="chip" IsVisible="{Binding Session.CanAccessCheckout}"
                                BorderBrush="{DynamicResource SuccessBright}" Foreground="{DynamicResource SuccessBright}"
                                Content="{Binding CustomerDisplayLabel}" ToolTip.Tip="{Binding CustomerDisplayFullLabel}"
                                Command="{Binding OpenCustomerDisplayCommand}"/>

                        <!-- LAN server chip: "🌐 LAN · n" (clients) / "🌐 LAN ⚠️"; tap = copy the browser-KDS URL.
                             Hidden when Server.Enabled=false; cashier and up. -->
                        <Button Classes="chip" IsVisible="{Binding IsLanChipVisible}"
                                BorderBrush="{DynamicResource Purple}" Foreground="{DynamicResource Purple}"
                                Content="{Binding LanChipDisplayText}" ToolTip.Tip="{Binding LanChipDisplayTooltip}"
                                Command="{Binding CopyKdsUrlCommand}"/>

                        <!-- Terminal chip: this register (CAJA-01) or, on a satellite, the link state with the master. Not a button. -->
                        <Border Classes="chipRow" IsVisible="{Binding IsTerminalChipVisible}" MaxWidth="260"
                                BorderBrush="{Binding TerminalChipColor}" ToolTip.Tip="{Binding TerminalChipDisplayTooltip}">
                            <TextBlock Text="{Binding TerminalChipDisplayText}" Foreground="{Binding TerminalChipColor}" FontWeight="Bold" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Border>

                        <!-- User chip: who is signed in + change user (back to PIN screen) -->
                        <StackPanel Orientation="Horizontal" IsVisible="{Binding Session.IsLoggedIn}">
                            <Border Classes="chipRow" BorderBrush="{DynamicResource Border}" MaxWidth="160" ToolTip.Tip="{Binding Session.ChipText}">
                                <TextBlock Text="{Binding UserChipText}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Border>
                            <Button Classes="chip"
                                    BorderBrush="{DynamicResource Warning}" Foreground="{DynamicResource WarningBright}"
                                    Content="{Binding LogoutLabel}" ToolTip.Tip="{Binding LogoutFullLabel}"
                                    Command="{Binding LogoutCommand}"/>
                        </StackPanel>

                        <!-- Theme chip (every role): 🌙 Oscuro / ☀️ Claro, tap toggles and persists. -->
                        <Button Classes="chip"
                                BorderBrush="{DynamicResource Border}" Foreground="{DynamicResource TextSecondary}"
                                Content="{Binding ThemeLabel}" ToolTip.Tip="{Binding ThemeFullLabel}"
                                Command="{Binding ToggleThemeCommand}"/>

                        <!-- Language chip (every role): 🌐 ES / 🌐 EN, tap toggles and persists (ui.json). -->
                        <Button Classes="chip"
                                BorderBrush="{DynamicResource Border}" Foreground="{DynamicResource TextSecondary}"
                                Content="{Binding LanguageLabel}" ToolTip.Tip="{Binding LanguageFullLabel}"
                                Command="{Binding ToggleLanguageCommand}"/>
                    </WrapPanel>

                    <!-- Collapsed (< 1750 px): ONE 48 px "⋯" chip. Its border carries the register status colour so a
                         red/amber state is still visible while collapsed. The Flyout lists the same chips at full size
                         with their full labels (vertical StackPanel; DataContext is inherited from the button). -->
                    <Button Classes="chip" IsVisible="{Binding IsToolsCollapsed}" Width="48" Padding="0" FontSize="20"
                            HorizontalContentAlignment="Center"
                            BorderBrush="{Binding TerminalChipColor}" Foreground="{DynamicResource TextPrimary}"
                            Content="{Binding MoreChipLabel}" ToolTip.Tip="{Binding MoreChipTooltip}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Transient">
                                <StackPanel Classes="flyout" Width="360" Spacing="2">
                                    <Button Classes="chip" IsVisible="{Binding Session.CanAccessCheckout}"
                                            BorderBrush="{DynamicResource Info}" Foreground="{DynamicResource Info}"
                                            Content="{Binding ScanFullLabel}" Command="{Binding TriggerBarcodeScanCommand}"/>

                                    <Button Classes="chip" IsVisible="{Binding Session.CanAccessCheckout}"
                                            BorderBrush="{DynamicResource SuccessBright}" Foreground="{DynamicResource SuccessBright}"
                                            Content="{Binding CustomerDisplayFullLabel}" Command="{Binding OpenCustomerDisplayCommand}"/>

                                    <Button Classes="chip" IsVisible="{Binding IsLanChipVisible}"
                                            BorderBrush="{DynamicResource Purple}" Foreground="{DynamicResource Purple}"
                                            Command="{Binding CopyKdsUrlCommand}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding LanChipText}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding LanChipTooltip}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Classes="chipRow" IsVisible="{Binding IsTerminalChipVisible}" BorderBrush="{Binding TerminalChipColor}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding TerminalChipText}" Foreground="{Binding TerminalChipColor}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding TerminalChipTooltip}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="chipRow" IsVisible="{Binding Session.IsLoggedIn}" BorderBrush="{DynamicResource Border}">
                                        <TextBlock Text="{Binding Session.ChipText}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                    <Button Classes="chip" IsVisible="{Binding Session.IsLoggedIn}"
                                            BorderBrush="{DynamicResource Warning}" Foreground="{DynamicResource WarningBright}"
                                            Content="{Binding LogoutFullLabel}" Command="{Binding LogoutCommand}"/>

                                    <Button Classes="chip"
                                            BorderBrush="{DynamicResource Border}" Foreground="{DynamicResource TextSecondary}"
                                            Content="{Binding ThemeFullLabel}" Command="{Binding ToggleThemeCommand}"/>

                                    <Button Classes="chip"
                                            BorderBrush="{DynamicResource Border}" Foreground="{DynamicResource TextSecondary}"
                                            Content="{Binding LanguageFullLabel}" Command="{Binding ToggleLanguageCommand}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Panel>
            </Grid>
        </Border>

        <!-- ── VIEW HOST ──────────────────────────────────────────── -->
        <!-- IsVisible must live on a WRAPPER: on the same element as DataContext="{Binding X}"
             it would resolve against the child ViewModel (no IsXActive there) → binding fails →
             every view stays visible and the last one covers the rest. -->
        <Grid Grid.Row="1">
            <Panel IsVisible="{Binding IsCheckoutActive}"><views:CheckoutView  DataContext="{Binding Checkout}"/></Panel>
            <Panel IsVisible="{Binding IsKdsActive}"><views:KdsView            DataContext="{Binding Kds}"/></Panel>
            <Panel IsVisible="{Binding IsCashShiftActive}"><views:CashShiftView DataContext="{Binding CashShift}"/></Panel>
            <Panel IsVisible="{Binding IsMastersActive}"><views:MastersView    DataContext="{Binding Masters}"/></Panel>
            <Panel IsVisible="{Binding IsComandaActive}"><views:ComandaView    DataContext="{Binding Comanda}"/></Panel>
            <Panel IsVisible="{Binding IsBillPaymentsActive}"><views:BillPaymentsView DataContext="{Binding BillPayments}"/></Panel>
        </Grid>

    </Grid>

    <!-- ── OVERLAYS (after the view host so they render on top; IsVisible on the wrapper) ── -->
    <Panel IsVisible="{Binding TerminalCharge.IsOpen}"><views:TerminalChargeDialog DataContext="{Binding TerminalCharge}"/></Panel>
    <Panel IsVisible="{Binding AuthPrompt.IsOpen}"><views:ManagerAuthDialog DataContext="{Binding AuthPrompt}"/></Panel>
    <Panel IsVisible="{Binding IsLoginVisible}"><views:LoginView DataContext="{Binding Login}"/></Panel>
    </Panel>
</Window>
