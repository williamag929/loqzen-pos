<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             xmlns:i18n="using:Presentation.Desktop.Localization"
             x:Class="Presentation.Desktop.Views.ShiftReportView"
             x:DataType="vm:CashShiftViewModel"
             x:CompileBindings="True">

    <!-- Closed-shift history; tap a row → its Z report (with reprint). -->
    <Border Background="{DynamicResource BgOverlay}">
        <Border Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="24"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1100">
            <Grid RowDefinitions="Auto, Auto, *">
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{i18n:Loc Cash.History.Title}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="Black"/>
                        <TextBlock Text="{i18n:Loc Cash.History.Hint}" Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Height="56" Padding="18,0" Margin="0,0,8,0" CornerRadius="12" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource AccentText}"
                                FontSize="15" FontWeight="Bold" Content="{i18n:Loc Cash.Day.Button}" Command="{Binding ShowDayConsolidationCommand}"/>
                        <Button Height="56" Padding="22,0" CornerRadius="12" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}"
                                FontSize="16" FontWeight="Bold" Content="{i18n:Loc Cash.CloseX}" Command="{Binding CloseHistoryCommand}"/>
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="80, *, 130, 130, 130, 110" Margin="16,0,16,6">
                    <TextBlock Grid.Column="0" Text="{i18n:Loc Cash.History.Col.Shift}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{i18n:Loc Cash.History.Col.Cashier}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="{i18n:Loc Cash.Expected}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{i18n:Loc Cash.Counted}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="{i18n:Loc Cash.Difference}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>

                <ScrollViewer Grid.Row="2">
                    <StackPanel>
                        <TextBlock Text="{i18n:Loc Cash.History.Empty}" Foreground="{DynamicResource TextFaint}" FontSize="15" Margin="16" IsVisible="{Binding !HasHistory}"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShiftHistoryRowViewModel">
                                    <Button Command="{Binding OpenCommand}" Background="{DynamicResource BgSurface}" CornerRadius="10" Padding="16,10" Margin="0,0,0,6"
                                            MinHeight="64" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="80, *, 130, 130, 130, 110">
                                            <TextBlock Grid.Column="0" Text="{Binding NumberText}" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CashierName}" Foreground="{DynamicResource Info}" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DatesText}" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ExpectedText}" Foreground="{DynamicResource TextPrimary}" FontSize="16" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CountedText}" Foreground="{DynamicResource TextPrimary}" FontSize="16" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding DifferenceText}" Foreground="{Binding DifferenceColor}" FontSize="17" FontWeight="Black"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                            <Border Grid.Column="5" Background="{DynamicResource SuccessSurface}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    IsVisible="{Binding HadManagerApproval}">
                                                <TextBlock Text="{i18n:Loc Cash.ManagerBadge}" Foreground="{DynamicResource SuccessText}" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</UserControl>
