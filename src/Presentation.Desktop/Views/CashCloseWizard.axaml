<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             xmlns:i18n="using:Presentation.Desktop.Localization"
             xmlns:views="using:Presentation.Desktop.Views"
             xmlns:conv="using:Presentation.Desktop.Converters"
             x:Class="Presentation.Desktop.Views.CashCloseWizard"
             x:DataType="vm:CashShiftViewModel"
             x:CompileBindings="True">

    <!-- Close wizard: 1 Revisión · 2 Conteo (a ciegas) · 3 Resultado · 4 Fondo. Big buttons, can go back. -->
    <UserControl.Styles>
        <Style Selector="Border.step">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style Selector="TextBlock.stepText">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.rowLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="TextBlock.rowValue">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style Selector="Button.big">
            <Setter Property="Height" Value="72"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BgOverlayStrong}">
        <Border Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource DangerStrong}" BorderThickness="2" CornerRadius="16" Padding="24" Margin="20"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1120" MaxHeight="860">
            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto">

                <!-- Title + step indicator -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{i18n:Loc Cash.Close.Title}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="Black"/>
                        <TextBlock Text="{Binding StepTitle}" Foreground="{DynamicResource TextMuted}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <Button Grid.Column="1" Height="52" Padding="18,0" CornerRadius="10" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}"
                            FontSize="15" FontWeight="Bold" VerticalAlignment="Top" Content="{i18n:Loc Cash.Close.CancelButton}" Command="{Binding CancelCloseWizardCommand}"/>
                </Grid>
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                    <Border Classes="step" Background="{DynamicResource Accent}"><TextBlock Classes="stepText" Text="{i18n:Loc Cash.Close.Step1.Chip}"/></Border>
                    <Border Classes="step" Background="{Binding IsStep2Reached, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter='Accent|BgSurface'}"><TextBlock Classes="stepText" Foreground="{Binding IsStep2Reached, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter=\'TextOnAccent|TextMuted\'}" Text="{i18n:Loc Cash.Close.Step2.Chip}"/></Border>
                    <Border Classes="step" Background="{Binding IsStep3Reached, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter='Accent|BgSurface'}"><TextBlock Classes="stepText" Foreground="{Binding IsStep3Reached, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter=\'TextOnAccent|TextMuted\'}" Text="{i18n:Loc Cash.Close.Step3.Chip}"/></Border>
                    <Border Classes="step" Background="{Binding IsStep4Reached, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter='Accent|BgSurface'}"><TextBlock Classes="stepText" Foreground="{Binding IsStep4Reached, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter=\'TextOnAccent|TextMuted\'}" Text="{i18n:Loc Cash.Close.Step4.Chip}"/></Border>
                </WrapPanel>

                <!-- ── STEPS ── -->
                <Panel Grid.Row="2">

                    <!-- STEP 1: review -->
                    <ScrollViewer IsVisible="{Binding IsStep1}">
                        <StackPanel Spacing="12">
                            <Border Background="{DynamicResource DangerSurface}" BorderBrush="{DynamicResource DangerStrong}" BorderThickness="1" CornerRadius="12" Padding="16" IsVisible="{Binding HasOpenComandas}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{Binding OpenComandasText}" Foreground="{DynamicResource DangerText}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Height="56" Padding="18,0" Margin="12,0,0,0" CornerRadius="10" Background="{DynamicResource DangerStrong}" Foreground="{DynamicResource TextOnAccent}"
                                            FontSize="15" FontWeight="Bold" Content="{i18n:Loc Cash.Close.ReviewAgain}" Command="{Binding RefreshCloseReviewCommand}"/>
                                </Grid>
                            </Border>
                            <UniformGrid Columns="2">
                                <Border Background="{DynamicResource BgSurface}" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{i18n:Loc Cash.Close.ShiftSales}" Foreground="{DynamicResource TextMuted}" FontSize="15" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="*, Auto"><TextBlock Classes="rowLabel" Text="{i18n:Loc Cash.Close.CashRow}"/><TextBlock Grid.Column="1" Classes="rowValue" Text="{Binding CloseCashSalesText}"/></Grid>
                                        <Grid ColumnDefinitions="*, Auto"><TextBlock Classes="rowLabel" Text="{i18n:Loc Cash.Close.CardRow}"/><TextBlock Grid.Column="1" Classes="rowValue" Text="{Binding CloseCardSalesText}"/></Grid>
                                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding CloseHasTerminalCharges}" Margin="16,0,0,0"><TextBlock Classes="rowLabel" Text="{i18n:Loc Cash.Close.TerminalRow}" FontSize="13"/><TextBlock Grid.Column="1" Classes="rowValue" FontSize="14" Text="{Binding CloseTerminalCardText}"/></Grid>
                                        <Grid ColumnDefinitions="*, Auto"><TextBlock Classes="rowLabel" Text="{i18n:Loc Cash.Close.TransferRow}"/><TextBlock Grid.Column="1" Classes="rowValue" Text="{Binding CloseTransferSalesText}"/></Grid>
                                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding HasOtherSales}"><TextBlock Classes="rowLabel" Text="{i18n:Loc Cash.Close.OtherRow}"/><TextBlock Grid.Column="1" Classes="rowValue" Text="{Binding CloseOtherSalesText}"/></Grid>
                                        <Separator Background="{DynamicResource Border}"/>
                                        <Grid ColumnDefinitions="*, Auto"><TextBlock Classes="rowLabel" FontWeight="Bold" Text="{i18n:Loc Cash.Close.TotalSales}"/><TextBlock Grid.Column="1" Classes="rowValue" FontSize="20" Text="{Binding CloseTotalSalesText}"/></Grid>
                                        <TextBlock Text="{Binding CloseOrderCountText}" Foreground="{DynamicResource TextFaint}" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BgSurface}" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{i18n:Loc Cash.Close.BeforeCounting}" Foreground="{DynamicResource TextMuted}" FontSize="15" FontWeight="Bold"/>
                                        <Border Background="{DynamicResource AccentSurface}" CornerRadius="10" Padding="12">
                                            <TextBlock Text="{Binding CloseCardExpectedText}" Foreground="{DynamicResource AccentText}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </Border>
                                        <Border Background="{DynamicResource AccentSurface}" CornerRadius="10" Padding="12">
                                            <TextBlock Text="{Binding CloseTransferExpectedText}" Foreground="{DynamicResource AccentText}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </Border>
                                        <TextBlock Text="{Binding CloseBillPaymentsText}" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CloseMovementsText}" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- STEP 2: count. Blind count: no expected / difference anywhere on this step. -->
                    <Grid IsVisible="{Binding IsStep2}" RowDefinitions="Auto, *">
                        <Border Background="{DynamicResource BgSurface}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                            <Panel>
                                <TextBlock IsVisible="{Binding IsBlindCount}" Text="{i18n:Loc Cash.Close.Step2.Blind}"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap"/>
                                <Grid IsVisible="{Binding CanSeeExpectedInCount}" ColumnDefinitions="*, Auto, Auto">
                                    <TextBlock Text="{i18n:Loc Cash.Close.Step2.Count}" Foreground="{DynamicResource TextSecondary}" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CountExpectedText}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold" Margin="12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CountLiveDifferenceText}" Foreground="{Binding CountLiveDifferenceColor}" FontSize="16" FontWeight="Black"/>
                                </Grid>
                            </Panel>
                        </Border>
                        <Panel Grid.Row="1"><views:CashCountGrid DataContext="{Binding CloseCount}"/></Panel>
                    </Grid>

                    <!-- STEP 3: result -->
                    <ScrollViewer IsVisible="{Binding IsStep3}">
                        <StackPanel Spacing="14">
                            <UniformGrid Columns="3">
                                <Border Background="{DynamicResource BgSurface}" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{i18n:Loc Cash.Expected}" Foreground="{DynamicResource TextMuted}" FontSize="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CloseExpectedText}" Foreground="{DynamicResource TextPrimary}" FontSize="30" FontWeight="Black" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BgSurface}" CornerRadius="12" Padding="16" Margin="4,0">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{i18n:Loc Cash.Counted}" Foreground="{DynamicResource TextMuted}" FontSize="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CloseCountedText}" Foreground="{DynamicResource Info}" FontSize="30" FontWeight="Black" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BgSurface}" CornerRadius="12" Padding="16" Margin="8,0,0,0" BorderBrush="{Binding CloseDifferenceColor}" BorderThickness="2">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{i18n:Loc Cash.Difference}" Foreground="{DynamicResource TextMuted}" FontSize="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CloseDifferenceText}" Foreground="{Binding CloseDifferenceColor}" FontSize="34" FontWeight="Black" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding CloseVerdictText}" Foreground="{Binding CloseDifferenceColor}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ThresholdText}" Foreground="{DynamicResource TextFaint}" FontSize="13" HorizontalAlignment="Center"/>

                            <Border Background="{DynamicResource WarningSurface}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="12" Padding="16" IsVisible="{Binding NeedsDifferenceApproval}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{i18n:Loc Cash.Close.ManagerRequired}" Foreground="{DynamicResource WarningText}" FontSize="18" FontWeight="Black"/>
                                    <TextBlock Text="{i18n:Loc Cash.Close.ManagerHint}"
                                               Foreground="{DynamicResource WarningText}" FontSize="14" TextWrapping="Wrap"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Height="60" Padding="22,0" Margin="0,0,12,8" CornerRadius="12" Background="{DynamicResource WarningStrong}" Foreground="{DynamicResource TextOnAccent}" FontSize="16" FontWeight="Bold"
                                                IsVisible="{Binding !HasDifferenceApproval}" Content="{i18n:Loc Cash.Close.Authorize}" Command="{Binding RequestDifferenceApprovalCommand}"/>
                                        <TextBlock Text="{Binding DifferenceApprovalText}" Foreground="{DynamicResource SuccessBright}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                                                   IsVisible="{Binding HasDifferenceApproval}" Margin="0,0,12,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBox Text="{Binding CloseNotes, Mode=TwoWay}" Height="80" FontSize="15" CornerRadius="10" Padding="12" TextWrapping="Wrap" AcceptsReturn="False"
                                     Watermark="{i18n:Loc Cash.Close.NotesWatermark}" MaxLength="500"/>
                            <Button Height="64" Padding="24,0" CornerRadius="12" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource AccentText}" FontSize="17" FontWeight="Bold"
                                    HorizontalAlignment="Left" Content="{i18n:Loc Cash.Close.Recount}" Command="{Binding RecountCommand}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- STEP 4: float for the next shift -->
                    <Grid IsVisible="{Binding IsStep4}" ColumnDefinitions="*, 400">
                        <StackPanel Spacing="14" Margin="0,0,20,0">
                            <TextBlock Text="{i18n:Loc Cash.Close.Step4.Question}" Foreground="{DynamicResource TextPrimary}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource BgSurface}" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{i18n:Loc Cash.Close.Step4.Float}" Foreground="{DynamicResource TextMuted}" FontSize="15"/>
                                    <TextBlock Text="{Binding FloatAmountText}" Foreground="{DynamicResource Info}" FontSize="40" FontWeight="Black"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SuccessSurface}" BorderBrush="{DynamicResource Success}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{i18n:Loc Cash.Close.Step4.Withdraw}" Foreground="{DynamicResource SuccessText}" FontSize="15"/>
                                    <TextBlock Text="{Binding WithdrawText}" Foreground="{DynamicResource SuccessBright}" FontSize="40" FontWeight="Black"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding FloatError}" Foreground="{DynamicResource DangerBright}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                                       IsVisible="{Binding FloatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <views:Numpad Grid.Column="1" VerticalAlignment="Top" DigitCommand="{Binding AppendFloatDigitCommand}"
                                      ClearCommand="{Binding ClearFloatCommand}" ExactCommand="{Binding UseDefaultFloatCommand}" ExactLabel="{i18n:Loc Cash.Numpad.Suggested}"/>
                    </Grid>
                </Panel>

                <!-- Error line -->
                <TextBlock Grid.Row="3" Text="{Binding CloseError}" Foreground="{DynamicResource DangerBright}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"
                           IsVisible="{Binding CloseError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Navigation -->
                <Grid Grid.Row="4" ColumnDefinitions="*, 2*" Margin="0,14,0,0">
                    <Button Grid.Column="0" Classes="big" Margin="0,0,10,0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" IsEnabled="{Binding CanGoBack}"
                            Content="{i18n:Loc Cash.Close.Back}" Command="{Binding CloseWizardBackCommand}"/>
                    <Panel Grid.Column="1">
                        <Button Classes="big" Background="{DynamicResource Accent}" Foreground="{DynamicResource TextOnAccent}" IsVisible="{Binding IsStep1}" IsEnabled="{Binding CanStartCount}"
                                Content="{i18n:Loc Cash.Close.StartCount}" Command="{Binding CloseWizardNextCommand}"/>
                        <Button Classes="big" Background="{DynamicResource Accent}" Foreground="{DynamicResource TextOnAccent}" IsVisible="{Binding IsStep2}"
                                Content="{i18n:Loc Cash.Close.ConfirmCount}" Command="{Binding CloseWizardNextCommand}"/>
                        <Button Classes="big" Background="{DynamicResource Accent}" Foreground="{DynamicResource TextOnAccent}" IsVisible="{Binding IsStep3}" IsEnabled="{Binding CanLeaveResult}"
                                Content="{i18n:Loc Cash.Close.Continue}" Command="{Binding CloseWizardNextCommand}"/>
                        <Button Classes="big" Background="{DynamicResource DangerStrong}" Foreground="{DynamicResource TextOnAccent}" FontSize="21" IsVisible="{Binding IsStep4}" IsEnabled="{Binding !IsBusy}"
                                Content="{i18n:Loc Cash.Close.Confirm}" Command="{Binding ConfirmCloseShiftCommand}"/>
                    </Panel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
