<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             xmlns:i18n="using:Presentation.Desktop.Localization"
             xmlns:views="using:Presentation.Desktop.Views"
             x:Class="Presentation.Desktop.Views.CashPartialCountDialog"
             x:DataType="vm:CashShiftViewModel"
             x:CompileBindings="True">

    <!-- Arqueo parcial: count without closing; result shows expected vs counted vs difference. -->
    <Border Background="{DynamicResource BgOverlay}">
        <Border Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource Info}" BorderThickness="2" CornerRadius="16" Padding="24" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1000">
            <Grid RowDefinitions="Auto, *, Auto, Auto">
                <StackPanel Spacing="4" Margin="0,0,0,14">
                    <TextBlock Text="{i18n:Loc Cash.Partial.Title}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="Black"/>
                    <TextBlock Text="{i18n:Loc Cash.Partial.Hint}" Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                </StackPanel>

                <Panel Grid.Row="1" MaxHeight="480"><views:CashCountGrid DataContext="{Binding PartialCount}"/></Panel>

                <Panel Grid.Row="2" IsVisible="{Binding HasPartialResult}">
                    <Border Background="{DynamicResource BgSurface}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                        <UniformGrid Columns="3">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{i18n:Loc Cash.Expected}" Foreground="{DynamicResource TextMuted}" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PartialExpectedText}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{i18n:Loc Cash.Counted}" Foreground="{DynamicResource TextMuted}" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PartialCountedText}" Foreground="{DynamicResource Info}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{i18n:Loc Cash.Difference}" Foreground="{DynamicResource TextMuted}" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PartialDifferenceText}" Foreground="{Binding PartialDifferenceColor}" FontSize="28" FontWeight="Black" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Panel>

                <Grid Grid.Row="3" ColumnDefinitions="*, 2*" Margin="0,16,0,0">
                    <Button Height="64" Margin="0,0,8,0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold" CornerRadius="12"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Content="{i18n:Loc Common.Close}" Command="{Binding ClosePartialCountCommand}"/>
                    <Button Grid.Column="1" Height="64" Background="{DynamicResource Accent}" Foreground="{DynamicResource TextOnAccent}" FontSize="18" FontWeight="Black" CornerRadius="12"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            IsEnabled="{Binding !IsBusy}" Content="{i18n:Loc Cash.Partial.Save}" Command="{Binding SavePartialCountCommand}"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
