<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             xmlns:i18n="using:Presentation.Desktop.Localization"
             x:Class="Presentation.Desktop.Views.ComandaNotesEditor"
             x:DataType="vm:ComandaViewModel"
             x:CompileBindings="True">

    <!-- Quick-note chips: plain surface, "active" = WarningStrong fill (the editor's amber accent) -->
    <UserControl.Styles>
        <Style Selector="Button.note">
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.note.active">
            <Setter Property="Background" Value="{DynamicResource WarningStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningStrong}"/>
        </Style>
    </UserControl.Styles>

    <!-- Modal notes editor: quick chips (one tap) + free text. Item is on hold while this is open. -->
    <Border Background="{DynamicResource BgOverlay}">
        <Border Background="{DynamicResource BgApp}" BorderBrush="{DynamicResource Warning}" BorderThickness="2" CornerRadius="16" Padding="24"
                Width="760" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <TextBlock Text="{Binding NotesEditorTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="Black" TextWrapping="Wrap"/>
                <TextBlock Text="{i18n:Loc Comanda.Notes.Hold}" Foreground="{DynamicResource WarningBright}" FontSize="14"/>

                <TextBlock Text="{i18n:Loc Comanda.Notes.QuickHeader}" Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                <ItemsControl ItemsSource="{Binding QuickNoteChips}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickNoteChipViewModel">
                            <Button Classes="note" Classes.active="{Binding IsActive}" MinWidth="150" Height="56" Margin="4" Padding="14,0" CornerRadius="28"
                                    FontSize="16" FontWeight="Bold"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Content="{Binding Label}" Command="{Binding ToggleCommand}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="{i18n:Loc Comanda.Notes.FreeText}" Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="{Binding NotesCounter}" Foreground="{DynamicResource TextFaint}" FontSize="13"/>
                </Grid>
                <TextBox Text="{Binding NotesText, Mode=TwoWay}" MaxLength="{Binding MaxNotesLength}"
                         Height="90" FontSize="18" TextWrapping="Wrap" AcceptsReturn="False" CornerRadius="10" Padding="12"
                         Watermark="{i18n:Loc Comanda.Notes.Watermark}"/>

                <Grid ColumnDefinitions="*, *, 2*">
                    <Button Height="64" Margin="0,0,6,0" CornerRadius="10" Background="{DynamicResource Border}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Content="{i18n:Loc Common.Cancel}" Command="{Binding CancelNotesCommand}"/>
                    <Button Grid.Column="1" Height="64" Margin="6,0" CornerRadius="10" Background="{DynamicResource DangerSurface}" Foreground="{DynamicResource DangerText}" FontSize="16" FontWeight="Bold"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Content="{i18n:Loc Comanda.Notes.Clear}" Command="{Binding ClearNotesCommand}"/>
                    <Button Grid.Column="2" Height="64" Margin="6,0,0,0" CornerRadius="10" Background="{DynamicResource WarningStrong}" Foreground="{DynamicResource TextOnAccent}" FontSize="18" FontWeight="Black"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Content="{i18n:Loc Comanda.Notes.Save}" Command="{Binding SaveNotesCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
