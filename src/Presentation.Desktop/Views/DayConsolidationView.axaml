<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             x:Class="Presentation.Desktop.Views.DayConsolidationView"
             x:DataType="vm:CashShiftViewModel"
             x:CompileBindings="True">

    <!-- "Cierre del día": one row per register for the chosen date + totals; prints through the Z-report path.
         Wide: 9-column table. Narrow (< 1000 px, set in code-behind): two-line cards so nothing squashes. -->
    <Border Background="#CC000000">
        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="16" Padding="24" Margin="24"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1240">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto">

                <!-- Title + close -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DayTitle}" Foreground="White" FontSize="22" FontWeight="Black" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DaySubtitle}" Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Height="56" Padding="22,0" CornerRadius="12" Background="#334155" Foreground="White"
                            FontSize="16" FontWeight="Bold" VerticalAlignment="Top" Content="✖ Cerrar" Command="{Binding CloseDayConsolidationCommand}"/>
                </Grid>

                <!-- Date navigation: ◀ / ▶ 48 px -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Height="48" MinWidth="64" Padding="18,0" Margin="0,0,8,6" CornerRadius="10" Background="#1E293B" Foreground="White"
                            FontSize="18" FontWeight="Black" Content="◀" ToolTip.Tip="Día anterior"
                            IsEnabled="{Binding !IsLoadingDay}" Command="{Binding PreviousDayCommand}"/>
                    <Button Height="48" MinWidth="64" Padding="18,0" Margin="0,0,16,6" CornerRadius="10" Background="#1E293B" Foreground="White"
                            FontSize="18" FontWeight="Black" Content="▶" ToolTip.Tip="Día siguiente"
                            IsEnabled="{Binding CanGoNextDay}" Command="{Binding NextDayCommand}"/>
                    <Button Height="48" Padding="18,0" Margin="0,0,8,6" CornerRadius="10" Background="#1E3A5F" Foreground="White"
                            FontSize="15" FontWeight="Bold" Content="🖨️ Imprimir" ToolTip.Tip="Imprime el cierre del día en la impresora de recibos"
                            IsEnabled="{Binding HasDayRows}" Command="{Binding PrintDayConsolidationCommand}"/>
                </WrapPanel>

                <!-- Warning (open shifts / load error) -->
                <Border Grid.Row="2" Background="#3B2F0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                        IsVisible="{Binding HasDayWarning}">
                    <TextBlock Text="{Binding DayWarning}" Foreground="#FDE68A" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- Column headers (wide only) -->
                <Grid Grid.Row="3" x:Name="WideHeader" ColumnDefinitions="110, 150, *, *, *, *, *, *, 120" Margin="16,0,16,6">
                    <TextBlock Grid.Column="0" Text="Caja" Foreground="#64748B" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Turnos" Foreground="#64748B" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Efectivo" Foreground="#64748B" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="Tarjeta" Foreground="#64748B" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="Transf." Foreground="#64748B" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="Otros" Foreground="#64748B" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="Recaudos" Foreground="#64748B" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="Total ventas" Foreground="#64748B" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="8" Text="Diferencia" Foreground="#64748B" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>

                <ScrollViewer Grid.Row="4">
                    <StackPanel>
                        <TextBlock Text="Sin turnos ni ventas en esta fecha." Foreground="#64748B" FontSize="15" Margin="16" IsVisible="{Binding !HasDayRows}"/>

                        <!-- Wide table -->
                        <ItemsControl x:Name="WideTable" ItemsSource="{Binding DayRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TerminalDayRowViewModel">
                                    <Border Background="{Binding Background}" CornerRadius="10" Padding="16,10" Margin="0,0,0,6" MinHeight="56">
                                        <Grid ColumnDefinitions="110, 150, *, *, *, *, *, *, 120">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Code}" Foreground="{Binding CodeColor}" FontSize="16" FontWeight="Black"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding ShiftsText}" Foreground="{Binding ShiftsColor}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding OrdersText}" Foreground="#94A3B8" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CashText}" Foreground="White" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CardText}" Foreground="White" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TransferText}" Foreground="White" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding OtherText}" Foreground="White" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding BillPaymentsText}" Foreground="#A7F3D0" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding TotalText}" Foreground="White" FontSize="15" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="8" Text="{Binding DifferenceText}" Foreground="{Binding DifferenceColor}" FontSize="16" FontWeight="Black"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Narrow cards (hidden until the code-behind enables them) -->
                        <ItemsControl x:Name="CompactList" ItemsSource="{Binding DayRows}" IsVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TerminalDayRowViewModel">
                                    <Border Background="{Binding Background}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                            <WrapPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Code}" Foreground="{Binding CodeColor}" FontSize="16" FontWeight="Black" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding ShiftsText}" Foreground="{Binding ShiftsColor}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding OrdersText}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                            </WrapPanel>
                                            <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding CompactDetailText}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <StackPanel Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="2">
                                                <TextBlock Text="{Binding TotalText}" Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Right"/>
                                                <TextBlock Text="{Binding DifferenceText}" Foreground="{Binding DifferenceColor}" FontSize="15" FontWeight="Black" TextAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="5" Text="Diferencia = Σ (contado − esperado) de los turnos cerrados de cada caja. Verde exacto · ámbar dentro del margen · rojo supera el margen."
                           Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Border>
</UserControl>
