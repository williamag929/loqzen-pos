<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             xmlns:i18n="using:Presentation.Desktop.Localization"
             xmlns:conv="using:Presentation.Desktop.Converters"
             x:Class="Presentation.Desktop.Views.DayConsolidationView"
             x:DataType="vm:CashShiftViewModel"
             x:CompileBindings="True">

    <!-- "Cierre del día": one row per register for the chosen date + totals; prints through the Z-report path.
         Wide: 9-column table. Narrow (< 1000 px, set in code-behind): two-line cards so nothing squashes. -->
    <Border Background="{DynamicResource BgOverlay}">
        <Border Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="24"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1240">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto">

                <!-- Title + close -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DayTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="Black" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DaySubtitle}" Foreground="{DynamicResource TextMuted}" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Height="56" Padding="22,0" CornerRadius="12" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}"
                            FontSize="16" FontWeight="Bold" VerticalAlignment="Top" Content="{i18n:Loc Cash.CloseX}" Command="{Binding CloseDayConsolidationCommand}"/>
                </Grid>

                <!-- Date navigation: ◀ / ▶ 48 px -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Height="48" MinWidth="64" Padding="18,0" Margin="0,0,8,6" CornerRadius="10" Background="{DynamicResource BgSurface}" Foreground="{DynamicResource TextPrimary}"
                            FontSize="18" FontWeight="Black" Content="◀" ToolTip.Tip="{i18n:Loc Cash.Day.Previous}"
                            IsEnabled="{Binding !IsLoadingDay}" Command="{Binding PreviousDayCommand}"/>
                    <Button Height="48" MinWidth="64" Padding="18,0" Margin="0,0,16,6" CornerRadius="10" Background="{DynamicResource BgSurface}" Foreground="{DynamicResource TextPrimary}"
                            FontSize="18" FontWeight="Black" Content="▶" ToolTip.Tip="{i18n:Loc Cash.Day.Next}"
                            IsEnabled="{Binding CanGoNextDay}" Command="{Binding NextDayCommand}"/>
                    <Button Height="48" Padding="18,0" Margin="0,0,8,6" CornerRadius="10" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource AccentText}"
                            FontSize="15" FontWeight="Bold" Content="{i18n:Loc Cash.Day.Print}" ToolTip.Tip="{i18n:Loc Cash.Day.PrintTip}"
                            IsEnabled="{Binding HasDayRows}" Command="{Binding PrintDayConsolidationCommand}"/>
                </WrapPanel>

                <!-- Warning (open shifts / load error) -->
                <Border Grid.Row="2" Background="{DynamicResource WarningSurface}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                        IsVisible="{Binding HasDayWarning}">
                    <TextBlock Text="{Binding DayWarning}" Foreground="{DynamicResource WarningText}" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- Column headers (wide only) -->
                <Grid Grid.Row="3" x:Name="WideHeader" ColumnDefinitions="110, 150, *, *, *, *, *, *, 120" Margin="16,0,16,6">
                    <TextBlock Grid.Column="0" Text="{i18n:Loc Cash.Day.Col.Register}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{i18n:Loc Cash.Day.Col.Shifts}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="{i18n:Loc Cash.Day.Col.Cash}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{i18n:Loc Cash.Day.Col.Card}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="{i18n:Loc Cash.Day.Col.Transfer}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="{i18n:Loc Cash.Day.Col.Other}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="{i18n:Loc Cash.Day.Col.BillPayments}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="{i18n:Loc Cash.Day.Col.Total}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="8" Text="{i18n:Loc Cash.Difference}" Foreground="{DynamicResource TextFaint}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>

                <ScrollViewer Grid.Row="4">
                    <StackPanel>
                        <TextBlock Text="{i18n:Loc Cash.Day.Empty}" Foreground="{DynamicResource TextFaint}" FontSize="15" Margin="16" IsVisible="{Binding !HasDayRows}"/>

                        <!-- Wide table -->
                        <ItemsControl x:Name="WideTable" ItemsSource="{Binding DayRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TerminalDayRowViewModel">
                                    <Border Background="{Binding IsTotal, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter='AccentSurface|BgSurface'}" CornerRadius="10" Padding="16,10" Margin="0,0,0,6" MinHeight="56">
                                        <Grid ColumnDefinitions="110, 150, *, *, *, *, *, *, 120">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Code}" Foreground="{Binding IsTotal, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter='AccentText|TextPrimary'}" FontSize="16" FontWeight="Black"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding ShiftsText}" Foreground="{Binding ShiftsColor}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding OrdersText}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CashText}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CardText}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TransferText}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding OtherText}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding BillPaymentsText}" Foreground="{DynamicResource SuccessText}" FontSize="14" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding TotalText}" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="8" Text="{Binding DifferenceText}" Foreground="{Binding DifferenceColor}" FontSize="16" FontWeight="Black"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Narrow cards (hidden until the code-behind enables them) -->
                        <ItemsControl x:Name="CompactList" ItemsSource="{Binding DayRows}" IsVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TerminalDayRowViewModel">
                                    <Border Background="{Binding IsTotal, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter='AccentSurface|BgSurface'}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                            <WrapPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Code}" Foreground="{Binding IsTotal, Converter={x:Static conv:BoolToResourceConverter.Instance}, ConverterParameter='AccentText|TextPrimary'}" FontSize="16" FontWeight="Black" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding ShiftsText}" Foreground="{Binding ShiftsColor}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding OrdersText}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                            </WrapPanel>
                                            <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding CompactDetailText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <StackPanel Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="2">
                                                <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold" TextAlignment="Right"/>
                                                <TextBlock Text="{Binding DifferenceText}" Foreground="{Binding DifferenceColor}" FontSize="15" FontWeight="Black" TextAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="5" Text="{i18n:Loc Cash.Day.Legend}"
                           Foreground="{DynamicResource TextFaint}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Border>
</UserControl>
