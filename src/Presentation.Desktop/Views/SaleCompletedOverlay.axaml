<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             x:Class="Presentation.Desktop.Views.SaleCompletedOverlay"
             x:DataType="vm:SaleSummaryViewModel"
             x:CompileBindings="True">

    <!-- "Cambio a entregar": shown after paying, until the cashier taps Nueva venta. -->
    <Border Background="#D9000000">
        <Border Background="#0F172A" BorderBrush="#10B981" BorderThickness="3" CornerRadius="20" Padding="32"
                Width="640" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="18">
                <TextBlock Text="{Binding Title}" Foreground="#A7F3D0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                <Border Background="#1E293B" CornerRadius="14" Padding="20,24">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Headline}" Foreground="#94A3B8" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BigFigure}" Foreground="{Binding BigFigureColor}" FontSize="84" FontWeight="Black"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*, *, *">
                    <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="Total" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalText}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center" IsVisible="{Binding IsCash}">
                        <TextBlock Text="Recibido" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TenderedText}" Foreground="#38BDF8" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="Medio de pago" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MethodText}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Button Height="80" CornerRadius="14" Background="#059669" Foreground="White" FontSize="24" FontWeight="Black"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Content="{Binding DismissLabel}" Command="{Binding DismissCommand}"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
