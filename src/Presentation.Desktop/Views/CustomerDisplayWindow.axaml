<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Presentation.Desktop.ViewModels"
        xmlns:dtos="using:Core.Application.DTOs"
        xmlns:i18n="using:Presentation.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:Class="Presentation.Desktop.Views.CustomerDisplayWindow"
        x:DataType="vm:CustomerDisplayViewModel"
        Title="{i18n:Loc Display.WindowTitle}"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgApp}">

    <!-- Second-screen window: follows the app theme (Styles/Theme.axaml tokens only).
         Old navy palette mapped by role: window/inner cards → BgApp / BgSurface2, panels → BgSurface, panel outlines → BorderStrong, cyan accents → Info. -->
    <Grid RowDefinitions="Auto, *">
        <!-- Top Banner -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurface}" Padding="24,16" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding StoreName}" Foreground="{DynamicResource Info}" FontSize="24" FontWeight="Black"/>
                    <TextBlock Text="{Binding StoreTagline}" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource BgSurface2}" CornerRadius="8" Padding="14,8" BorderBrush="{DynamicResource Info}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{i18n:Loc Display.Badge}" Foreground="{DynamicResource Info}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body Grid: Left Items List, Right Dynamic Payment & Totals -->
        <Grid Grid.Row="1" ColumnDefinitions="3*, 2*" Margin="20">
            <!-- LEFT PANEL: TICKET DETAIL -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurface}" CornerRadius="12" Padding="20" Margin="0,0,14,0" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- "Su compra" for quick sale, "Mesa 4 · Comanda #12" when fed by the comanda screen -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                        <TextBlock Text="📋" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ContextTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Scrollable items list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dtos:CartItemDto">
                                    <Panel>
                                        <!-- Normal item -->
                                        <Border Background="{DynamicResource BgSurface2}" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" IsVisible="{Binding !IsReturn}">
                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding UnitPrice, StringFormat='${0:N0}'}" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                                                    <TextBlock Text="×" Foreground="{DynamicResource TextFaint}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Quantity}" Foreground="{DynamicResource Info}" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock IsVisible="{Binding IsWeighed}" Text="{Binding WeightKg, StringFormat='({0:F2} kg)'}" Foreground="{DynamicResource Success}" FontSize="13"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat='${0:N0}'}" Foreground="{DynamicResource Success}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Return item (credit note) -->
                                    <Border Background="{DynamicResource DangerSurface}" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="{DynamicResource Danger}" BorderThickness="2" IsVisible="{Binding IsReturn}">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{i18n:Loc Display.Return.Label}" Foreground="{DynamicResource DangerBright}" FontSize="15" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource DangerBright}" FontSize="15" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="{i18n:Loc Display.Return.Note}" Foreground="{DynamicResource DangerBright}" FontSize="12" FontStyle="Italic"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding UnitPrice, StringFormat='${0:N0}'}" Foreground="{DynamicResource DangerBright}" FontSize="13"/>
                                                    <TextBlock Text="×" Foreground="{DynamicResource Danger}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Quantity}" Foreground="{DynamicResource DangerBright}" FontSize="13" FontWeight="Bold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='${0:N0}'}" Foreground="{DynamicResource DangerBright}" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Breakdown at bottom -->
                    <Border Grid.Row="2" Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Loc Display.Subtotal}" Foreground="{DynamicResource TextMuted}" FontSize="14"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:N0}'}" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Loc Display.Discount}" Foreground="{DynamicResource Warning}" FontSize="14" Margin="0,4,0,0" IsVisible="{Binding DiscountTotal, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=0}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountTotal, StringFormat='-${0:N0}'}" Foreground="{DynamicResource Warning}" FontSize="14" Margin="0,4,0,0" IsVisible="{Binding DiscountTotal, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=0}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{i18n:Loc Display.TaxIncluded}" Foreground="{DynamicResource TextMuted}" FontSize="14" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxTotal, StringFormat='${0:N0}'}" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: DYNAMIC TOTAL & QR / PAYMENT VISOR -->
            <Border Grid.Column="1" Background="{DynamicResource BgSurface}" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Total Header Box -->
                    <Border Grid.Row="0" Background="{DynamicResource BgSurface2}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Success}" BorderThickness="2" Margin="0,0,0,16">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="{i18n:Loc Display.TotalDue}" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Total, StringFormat='${0:N0}'}" Foreground="{DynamicResource Success}" FontSize="36" FontWeight="Black" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Middle Dynamic Panel: QR Code and Payment state -->
                    <Border Grid.Row="1" Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{i18n:Loc Display.EPayment}" Foreground="{DynamicResource Info}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            
                            <!-- Stylized QR Code Graphic Container.
                                 Intentionally NOT themed: a QR code must stay black modules on a white quiet zone to be scannable,
                                 so the named colours White/Black are the correct constants here in both themes. -->
                            <Border Width="160" Height="160" Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
                                <Grid RowDefinitions="*, *, *" ColumnDefinitions="*, *, *">
                                    <!-- QR Finder Patterns -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="Black" CornerRadius="4" Margin="3">
                                        <Border Background="White" Margin="4">
                                            <Border Background="Black" Margin="3"/>
                                        </Border>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="2" Background="Black" CornerRadius="4" Margin="3">
                                        <Border Background="White" Margin="4">
                                            <Border Background="Black" Margin="3"/>
                                        </Border>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="0" Background="Black" CornerRadius="4" Margin="3">
                                        <Border Background="White" Margin="4">
                                            <Border Background="Black" Margin="3"/>
                                        </Border>
                                    </Border>
                                    <!-- QR Data Dots Emulation -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="LOQZEN" FontSize="9" FontWeight="Black" Foreground="Black" HorizontalAlignment="Center"/>
                                        <TextBlock Text="PAY" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentStrong}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Row="0" Grid.Column="1" Background="Black" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Grid.Column="0" Background="Black" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Grid.Column="2" Background="Black" Width="8" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Row="2" Grid.Column="1" Background="Black" Width="12" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Row="2" Grid.Column="2" Background="Black" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{i18n:Loc Display.ScanHint}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Cash Payment Recap -->
                            <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Loc Display.Tendered}" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TenderedAmount, StringFormat='${0:N0}'}" Foreground="{DynamicResource Info}" FontSize="14" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Loc Display.YourChange}" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChangeAmount, StringFormat='${0:N0}'}" Foreground="{DynamicResource SuccessStrong}" FontSize="16" FontWeight="Black" Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Footer Message -->
                    <Border Grid.Row="2" Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                        <TextBlock Text="{i18n:Loc Display.Thanks}" 
                                   Foreground="{DynamicResource Purple}" 
                                   FontSize="12" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
