<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             x:Class="Presentation.Desktop.Views.ComandaCatalogPanel"
             x:DataType="vm:ComandaViewModel"
             x:CompileBindings="True">

    <!-- Category tiles keep the category's own colour (user data) with TextOnAccent; the colourless "Otros" tile ("neutral")
         uses the theme's BorderStrong fill + TextPrimary. "selected" draws a TextPrimary frame. -->
    <UserControl.Styles>
        <Style Selector="Button.cat">
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.cat.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.cat TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        </Style>
        <Style Selector="Button.cat.neutral TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </UserControl.Styles>

    <!-- Touch catalog, two levels: big category tiles → products of that category (◀ back). -->
    <Grid RowDefinitions="Auto, *">
        <Grid Margin="0,0,0,10">
            <Button Height="56" Padding="18,0" CornerRadius="10" Background="{DynamicResource Border}" Foreground="{DynamicResource TextPrimary}"
                    FontSize="18" FontWeight="Bold" Content="{Binding CatalogTitle}"
                    IsVisible="{Binding IsBrowsingProducts}" Command="{Binding BackToCategoriesCommand}"/>
            <TextBlock Text="{Binding CatalogTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                       IsVisible="{Binding IsBrowsingCategories}"/>
        </Grid>

        <!-- Level 1: categories -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsBrowsingCategories}">
            <ItemsControl ItemsSource="{Binding CategoryTiles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryTileViewModel">
                        <Button Classes="cat" Classes.selected="{Binding IsSelected}" Classes.neutral="{Binding IsNeutral}"
                                Width="200" Height="130" Margin="6" CornerRadius="14" Background="{Binding Background}" BorderThickness="3"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding SelectCommand}">
                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Level 2: products -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsBrowsingProducts}">
            <ItemsControl ItemsSource="{Binding ProductTiles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductTileViewModel">
                        <Button Width="180" Height="130" Margin="6" Padding="12" CornerRadius="12" Background="{DynamicResource BgSurface}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Command="{Binding AddCommand}">
                            <Grid RowDefinitions="*, Auto">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3"/>
                                <TextBlock Grid.Row="1" Text="{Binding PriceText}" Foreground="{DynamicResource SuccessBright}" FontSize="18" FontWeight="Bold"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
