<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             xmlns:i18n="using:Presentation.Desktop.Localization"
             xmlns:views="using:Presentation.Desktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="Presentation.Desktop.Views.CashShiftView"
             x:DataType="vm:CashShiftViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BgSurface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style Selector="TextBlock.cardLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.cardDetail">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button.move">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ── HEADER ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource BgBar}" Padding="24,12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">
                <Border Grid.Column="0" BorderBrush="{Binding ShiftStatusColor}" BorderThickness="0,0,0,2" Padding="0,0,0,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShiftStatusText}" Foreground="{Binding ShiftStatusColor}"
                               FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                </Border>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Outbox sync (ERP webhook): counts + retry of Failed messages. -->
                    <Border Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="48" Margin="4">
                        <TextBlock Text="{Binding SyncStatusText}" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Button Height="48" Padding="14,0" Margin="4"
                            Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="8"
                            Foreground="{DynamicResource Warning}" FontSize="13" FontWeight="Bold"
                            Content="{i18n:Loc Cash.Sync.Retry}"
                            IsVisible="{Binding HasFailedSync}" IsEnabled="{Binding !IsRetryingSync}"
                            Command="{Binding RetryFailedSyncCommand}"/>
                    <Button Height="52" Padding="18,0" Margin="4" Background="{DynamicResource BgSurface}" Foreground="{DynamicResource TextPrimary}"
                            FontSize="15" FontWeight="Bold" CornerRadius="8"
                            Content="{i18n:Loc Cash.History}" Command="{Binding ShowHistoryCommand}"/>
                    <Button Height="52" Padding="18,0" Margin="4" Background="{DynamicResource BgSurface}" Foreground="{DynamicResource TextPrimary}"
                            FontSize="15" FontWeight="Bold" CornerRadius="8"
                            Content="{i18n:Loc Cash.Day.Button}" Command="{Binding ShowDayConsolidationCommand}"/>
                    <Button Height="52" Padding="22,0" Margin="4" Background="{DynamicResource Accent}" Foreground="{DynamicResource TextOnAccent}"
                            FontSize="15" FontWeight="Bold" CornerRadius="8"
                            Content="{i18n:Loc Cash.Open.Header}" IsVisible="{Binding !IsShiftOpen}"
                            Command="{Binding ShowOpenDialogCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ── MAIN PANEL ──────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Background="{DynamicResource BgBar}" Padding="24,20">
            <StackPanel Spacing="8">

                <!-- ═══ OPEN SHIFT: live dashboard ═══ -->
                <StackPanel Spacing="8" IsVisible="{Binding IsShiftOpen}">
                    <UniformGrid Columns="4">
                        <Border Classes="card" BorderBrush="{DynamicResource Success}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="cardLabel" Text="{i18n:Loc Cash.Dash.ExpectedCash}"/>
                                <TextBlock Text="{Binding ExpectedCashText}" Foreground="{DynamicResource SuccessBright}" FontSize="30" FontWeight="Black" TextWrapping="Wrap"/>
                                <TextBlock Classes="cardDetail" Text="{Binding OpeningText}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="cardLabel" Text="{i18n:Loc Cash.Dash.Sales}"/>
                                <TextBlock Text="{Binding SalesText}" Foreground="{DynamicResource TextPrimary}" FontSize="30" FontWeight="Black"/>
                                <TextBlock Classes="cardDetail" Text="{Binding SalesDetailText}"/>
                                <TextBlock Classes="cardDetail" Text="{Binding TerminalCardDetailText}" IsVisible="{Binding HasTerminalCharges}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="cardLabel" Text="{i18n:Loc Cash.Dash.BillPayments}"/>
                                <TextBlock Text="{Binding BillPaymentsText}" Foreground="{DynamicResource Info}" FontSize="30" FontWeight="Black"/>
                                <TextBlock Classes="cardDetail" Text="{Binding BillPaymentsDetailText}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="cardLabel" Text="{i18n:Loc Cash.Dash.Movements}"/>
                                <TextBlock Text="{Binding MovementsText}" Foreground="{DynamicResource WarningBright}" FontSize="30" FontWeight="Black"/>
                                <TextBlock Classes="cardDetail" Text="{Binding MovementsDetailText}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Actions: movements (64 px), partial count, close -->
                    <TextBlock Text="{i18n:Loc Cash.Movements.Title}" Foreground="{DynamicResource TextMuted}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="move" BorderBrush="{DynamicResource Success}" BorderThickness="1" Content="{i18n:Loc Cash.Movement.PaidIn}" Command="{Binding StartMovementCommand}" CommandParameter="PaidIn"/>
                        <Button Classes="move" BorderBrush="{DynamicResource DangerBright}" BorderThickness="1" Content="{i18n:Loc Cash.Movement.PaidOut}" Command="{Binding StartMovementCommand}" CommandParameter="PaidOut"/>
                        <Button Classes="move" BorderBrush="{DynamicResource DangerBright}" BorderThickness="1" Content="{i18n:Loc Cash.Movement.Expense}" Command="{Binding StartMovementCommand}" CommandParameter="Expense"/>
                        <Button Classes="move" BorderBrush="{DynamicResource DangerBright}" BorderThickness="1" Content="{i18n:Loc Cash.Movement.SafeDrop}" Command="{Binding StartMovementCommand}" CommandParameter="SafeDrop"/>
                        <Button Classes="move" BorderBrush="{DynamicResource DangerBright}" BorderThickness="1" Content="{i18n:Loc Cash.Movement.TipPayout}" Command="{Binding StartMovementCommand}" CommandParameter="TipPayout"/>
                        <Button Classes="move" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource AccentText}" Content="{i18n:Loc Cash.Partial.Button}" Command="{Binding ShowPartialCountCommand}"/>
                        <Button Classes="move" Background="{DynamicResource DangerStrong}" Foreground="{DynamicResource TextOnAccent}" FontSize="18" FontWeight="Black" Padding="28,0"
                                Content="{i18n:Loc Cash.Close.Button}" Command="{Binding ShowCloseWizardCommand}"/>
                    </WrapPanel>

                    <!-- Today's movements -->
                    <Border Classes="card" Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="cardLabel" Text="{i18n:Loc Cash.Movements.ShiftTitle}"/>
                            <TextBlock Classes="cardDetail" Text="{i18n:Loc Cash.Movements.Empty}" IsVisible="{Binding !HasMovements}"/>
                            <ItemsControl ItemsSource="{Binding Movements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CashMovementRowViewModel">
                                        <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextFaint}" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding AmountText}" Foreground="{Binding AmountColor}"
                                                           FontSize="20" FontWeight="Black" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ NO SHIFT ═══ -->
                <Border Classes="card" Padding="40" IsVisible="{Binding !IsShiftOpen}">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <TextBlock Text="💼" FontSize="52" HorizontalAlignment="Center"/>
                        <TextBlock Text="{i18n:Loc Cash.NoShift.Title}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{i18n:Loc Cash.NoShift.Hint}"
                                   Foreground="{DynamicResource TextFaint}" FontSize="15" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button Height="64" Padding="32,0" HorizontalAlignment="Center"
                                Background="{DynamicResource Accent}" Foreground="{DynamicResource TextOnAccent}" FontSize="18" FontWeight="Bold" CornerRadius="12"
                                Content="{i18n:Loc Cash.Open.Button}" Command="{Binding ShowOpenDialogCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── NOTIFICATION BAR ────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{DynamicResource BgSurface}" Padding="16,10"
                IsVisible="{Binding Notification, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Notification}" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap"/>
        </Border>

        <!-- ══ MODAL: OPEN SHIFT ═════════════════════════════════════════ -->
        <Border Grid.RowSpan="3" Background="{DynamicResource BgOverlay}" IsVisible="{Binding IsOpenDialogVisible}">
            <Border Width="540" Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                    CornerRadius="16" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="{i18n:Loc Cash.Open.Title}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{i18n:Loc Cash.Open.Cashier}" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CashierName, Mode=TwoWay}" Height="52" FontSize="16" CornerRadius="8" Padding="12,0"
                                 Watermark="{i18n:Loc Cash.Open.CashierWatermark}" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{i18n:Loc Cash.Open.Float}" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Info}" BorderThickness="1" CornerRadius="10" Padding="16,10">
                            <TextBlock Text="{Binding OpeningAmountText}" Foreground="{DynamicResource Info}" FontSize="36" FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding SuggestedOpeningText}" Foreground="{DynamicResource SuccessText}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <views:Numpad DigitCommand="{Binding AppendOpeningNumpadCommand}" ClearCommand="{Binding ClearOpeningNumpadCommand}"
                                  ExactCommand="{Binding UseSuggestedOpeningCommand}" ExactLabel="{i18n:Loc Cash.Numpad.Suggested}"/>
                    <Grid ColumnDefinitions="*, 2*">
                        <Button Grid.Column="0" Height="64" Margin="0,0,8,0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold"
                                CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Content="{i18n:Loc Common.Cancel}" Command="{Binding CancelOpenDialogCommand}"/>
                        <Button Grid.Column="1" Height="64" Background="{DynamicResource Accent}" Foreground="{DynamicResource TextOnAccent}" FontSize="18" FontWeight="Black"
                                CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                IsEnabled="{Binding !IsBusy}" Content="{i18n:Loc Cash.Open.Confirm}" Command="{Binding ConfirmOpenShiftCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ══ OTHER MODALS (each a UserControl sharing this DataContext; IsVisible on the wrapper) ══ -->
        <Panel Grid.RowSpan="3" IsVisible="{Binding IsMovementDialogVisible}"><views:CashMovementDialog/></Panel>
        <Panel Grid.RowSpan="3" IsVisible="{Binding IsPartialCountVisible}"><views:CashPartialCountDialog/></Panel>
        <Panel Grid.RowSpan="3" IsVisible="{Binding IsCloseWizardVisible}"><views:CashCloseWizard/></Panel>
        <Panel Grid.RowSpan="3" IsVisible="{Binding IsHistoryVisible}"><views:ShiftReportView/></Panel>
        <Panel Grid.RowSpan="3" IsVisible="{Binding IsDayConsolidationVisible}"><views:DayConsolidationView/></Panel>
        <!-- Z report on top of the history (opened from a history row) -->
        <Panel Grid.RowSpan="3" IsVisible="{Binding IsZReportVisible}">
            <Border Background="{DynamicResource BgOverlayStrong}">
                <Border Background="{DynamicResource BgSurface2}" BorderBrush="{DynamicResource Success}" BorderThickness="2" CornerRadius="16" Padding="24" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                    <Grid RowDefinitions="Auto, Auto, *, Auto">
                        <TextBlock Text="{Binding ZReportTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="{Binding ZReportSummary}" Foreground="{Binding ZReportSummaryColor}" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,12"/>
                        <views:ReceiptPreviewControl Grid.Row="2" Lines="{Binding ZReportLines}" MaxHeight="520"/>
                        <Grid Grid.Row="3" ColumnDefinitions="*, *" Margin="0,16,0,0">
                            <Button Grid.Column="0" Height="64" Margin="0,0,8,0" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource AccentText}" FontSize="17" FontWeight="Bold"
                                    CornerRadius="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Content="{i18n:Loc Cash.Z.Print}" Command="{Binding PrintZReportCommand}"/>
                            <Button Grid.Column="1" Height="64" Background="{DynamicResource SuccessStrong}" Foreground="{DynamicResource TextOnAccent}" FontSize="18" FontWeight="Black"
                                    CornerRadius="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Content="{i18n:Loc Cash.Z.Done}" Command="{Binding DismissZReportCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Panel>
    </Grid>
</UserControl>
