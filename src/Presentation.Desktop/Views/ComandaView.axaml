<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Presentation.Desktop.ViewModels"
             xmlns:views="using:Presentation.Desktop.Views"
             xmlns:conv="using:Presentation.Desktop.Converters"
             xmlns:i18n="using:Presentation.Desktop.Localization"
             x:Class="Presentation.Desktop.Views.ComandaView"
             x:DataType="vm:ComandaViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource BgApp}">

    <!-- Colours: only Styles/Theme.axaml tokens ({DynamicResource}) — see CONTRIBUTING §4 "Temas". -->
    <UserControl.Resources>
        <conv:BoolToResourceConverter x:Key="BoolToResource"/>
    </UserControl.Resources>

    <!-- Restaurant mode: one panel at a time, ◀ ▶ buttons + horizontal swipe to navigate.
         0 = comandas (izq) · 1 = comanda actual (centro) · 2 = cierre/pago (der) -->
    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header: ◀  title + step dots  ▶ (64px touch targets) -->
        <Border Grid.Row="0" Background="{DynamicResource BgBar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0" Width="96" Height="64" CornerRadius="10" Background="{DynamicResource BgSurface}" Foreground="{DynamicResource TextPrimary}"
                        FontSize="26" FontWeight="Black" Content="◀" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsEnabled="{Binding CanGoLeft}" Command="{Binding GoLeftCommand}"/>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="{Binding PanelTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Border Width="70" Height="6" CornerRadius="3" Background="{Binding IsListPanel, Converter={StaticResource BoolToResource}, ConverterParameter='Info|Border'}"/>
                        <Border Width="70" Height="6" CornerRadius="3" Background="{Binding IsOrderPanel, Converter={StaticResource BoolToResource}, ConverterParameter='Info|Border'}"/>
                        <Border Width="70" Height="6" CornerRadius="3" Background="{Binding IsPayPanel, Converter={StaticResource BoolToResource}, ConverterParameter='Info|Border'}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Width="96" Height="64" CornerRadius="10" Background="{DynamicResource BgSurface}" Foreground="{DynamicResource TextPrimary}"
                        FontSize="26" FontWeight="Black" Content="▶" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsEnabled="{Binding CanGoRight}" Command="{Binding GoRightCommand}"/>
            </Grid>
        </Border>

        <!-- Panels (swipe area) -->
        <Panel Grid.Row="1" x:Name="SwipeArea" Background="Transparent">
            <views:ComandaListPanel  IsVisible="{Binding IsListPanel}"/>
            <views:ComandaOrderPanel IsVisible="{Binding IsOrderPanel}"/>
            <views:ComandaPayPanel   IsVisible="{Binding IsPayPanel}"/>
        </Panel>

        <!-- Notes editor overlay (covers header+panels so navigation is blocked while editing) -->
        <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsNotesEditorOpen}">
            <views:ComandaNotesEditor/>
        </Panel>

        <!-- "Cambio a entregar" after closing a table -->
        <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsSaleCompletedVisible}">
            <views:SaleCompletedOverlay DataContext="{Binding LastSale}"/>
        </Panel>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource BgSurface}" Padding="16,10">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Amber while the master does not answer (satellite); the screen stays usable -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="14" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding IsMasterOffline, Converter={StaticResource BoolToResource}, ConverterParameter='WarningBright|TextSecondary'}"/>
                <TextBlock Grid.Column="1" Text="{i18n:Loc Comanda.Status.NoShift}" Foreground="{DynamicResource DangerBright}" FontSize="14" FontWeight="Bold"
                           IsVisible="{Binding !IsShiftOpen}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
