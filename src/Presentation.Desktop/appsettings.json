{
  "Hardware": {
    "UseMockPrinter": true,
    "UseMockScale": true,
    "UseMockScanner": true,
    "PrinterHost": "127.0.0.1",
    "PrinterPort": 9100,
    "ScalePortName": "/dev/ttyUSB0",
    "ScaleBaudRate": 9600
  },
  "Comanda": {
    "ConfirmationDelaySeconds": 30,
    "QuickNotes": [
      "Sin cebolla",
      "Sin tomate",
      "Sin salsas",
      "Sin hielo",
      "Poco picante",
      "Extra queso",
      "Bien cocido",
      "Término medio",
      "Para llevar",
      "Alergia: maní",
      "Sin gluten",
      "Aparte"
    ]
  },
  "Kds": {
    "WarningMinutes": 5,
    "MaxPrepMinutes": 15,
    "ArchiveDelaySeconds": 20,
    "PollSeconds": 3
  },
  "Sync": {
    "Enabled": false,
    "WebhookUrl": "http://localhost:5000/webhook",
    "ApiKey": null,
    "IntervalSeconds": 15,
    "BatchSize": 50,
    "MaxRetries": 10,
    "TimeoutSeconds": 10
  },
  "Server": {
    "Enabled": true,
    "Port": 5055,
    "BindAddress": "0.0.0.0"
  },
  "Authorization": {
    "RequireLogin": true,
    "ManagerRequiredFor": ["ReturnItem", "ApplyDiscount", "CancelKitchenItem"]
  }
}
